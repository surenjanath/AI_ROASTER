# Copy to frontend/.env, or just run ./start.sh — it writes this file for you
# with your Mac's LAN IP so a physical phone on the same WiFi can reach the API.
#
#   Expo web / iOS simulator .... http://localhost:8001
#   Android emulator ............ http://10.0.2.2:8001
#                                 (or http://localhost:8001 after
#                                  `adb reverse tcp:8001 tcp:8001`)
#   Physical phone over LAN ..... http://<your-mac-ip>:8001
EXPO_PUBLIC_BACKEND_URL=http://localhost:8001
