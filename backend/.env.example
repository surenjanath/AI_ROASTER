# Copy to backend/.env and fill in.

# MongoDB connection string and database name (both required — the server
# raises KeyError on startup if either is missing).
MONGO_URL=mongodb://localhost:27017
DB_NAME=ai_roaster

# API key for the hosted-LLM provider, used only when Settings → AI Engine
# is set to "Emergent". Leave as-is if you only ever run against Ollama.
LLM_API_KEY=not-used-with-ollama
